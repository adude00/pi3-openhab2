val String LOG = "Scene05"

rule "Scene05"
when
    Item Scene05 changed to ON
then
  val prowl = getActions("prowl", "prowl:broker:mybroker")
  prowl.pushNotification("Scena Nanna di Ethan: Start!", "La scena Scene05 è stata attivata")
  logInfo(LOG,"Scene Started")

  shellytappEcho_roller.sendCommand(DOWN)
  shellytappFoxtrot_roller.sendCommand(DOWN)

  if (Scene05Condition1.state == ON) {
    logInfo(LOG,"Scene05Condition1.state == ON")
    alexa_campanello.sendCommand(OFF)
  }

  // Clima Camera 1: Scene05Condition3 abilita il controllo, Scene05Condition3Power ne impone lo stato (ON/OFF)
  if (Scene05Condition3.state == ON) {
    logInfo(LOG,"Scene05Condition3.state == ON - Stato clima richiesto: " + Scene05Condition3Power.state)

    if (Scene05Condition3Power.state == OFF) {
      faikin01_power.sendCommand(OFF)
    } else {
      faikin01_power.sendCommand(ON)

      if (Scene05Condition3bis.state == ON) {
        createTimer(now.plusSeconds(10), [|
          logInfo(LOG,"Scene05Condition3bis.state == ON - Setting up temperature: " + Scene05Condition3bisNum.state as Number)
          faikin01_temp.sendCommand(Scene05Condition3bisNum.state as Number)
       ])
      }
    }

  }

  // Termostato Camera 1: Scene05Condition4 abilita il controllo, Scene05Condition4Power ne impone lo stato (ON/OFF)
  if (Scene05Condition4.state == ON) {
    logInfo(LOG,"Scene05Condition4.state == ON - Stato termostato richiesto: " + Scene05Condition4Power.state)

    if (Scene05Condition4Power.state == OFF) {
      tsCamera1.sendCommand(OFF)
    } else {
      tsCamera1.sendCommand(ON)

      if (Scene05Condition4bis.state == ON) {
        createTimer(now.plusSeconds(10), [|
          logInfo(LOG,"Scene05Condition4bis.state == ON - Setting up temperature: " + Scene05Condition4bisNum.state as Number)
          tsCamera1sp.sendCommand(Scene05Condition4bisNum.state as Number)
       ])
      }
    }

  }

  if (Scene05Condition5.state == ON) {
    logInfo(LOG,"Scene05Condition5.state == ON")
    faikin01_fan.sendCommand("Q")
  }

  if (Scene05Condition6.state == ON) {
    logInfo(LOG,"Scene05Condition6.state == ON")
    cl02_metapower.sendCommand(OFF)
  }


  if (Scene05Condition7.state == ON) {
    logInfo(LOG,"Scene05Condition7.state == ON")
    createTimer(now.plusSeconds(7), [|
        val vol = Scene05Condition7Num.state as Number
        if (vol !== null) {
          Echo_Ethan_Volume.sendCommand(vol)
          logInfo(LOG,"Impostato volume di alexa a " + vol)
        } else {
          logWarn(LOG,"Volume Alexa non impostato: salto Echo_Ethan_Volume")
        }
        ])
  }

  createTimer(now.plusSeconds(13), [|
    Scene05.sendCommand(OFF)
    logInfo(LOG,"Scena finita")
  ])

end
