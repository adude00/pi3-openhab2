// See things/ble-buttons.things for what these buttons are.
//
// MAPPING (only these two actions exist, everything else is log-only):
//
//   button1, single click (code 1) -> tsBagnoP1 ON
//   button3, single click (code 1) -> tsBagnoP1 OFF
//
// Click codes published by the Shelly BLE gateway script:
//   1 = single, 2 = double, 3 = triple, 4 = long press
//
// Facts learned from Openhab.log / Events.log:
//
//  * ONE physical press produces several MQTT events (the gateway re-publishes
//    the BLE advertisement), so these rules must be idempotent:
//        single clicks  : repeats 0.3 - 7 s apart
//                         button3 12:50:31.735  12:50:32.690  12:50:38.413
//        multi clicks   : repeats ~100 ms apart AND the code escalates during
//                         the same press (button4: 2,2,3,3,3 within 400 ms), so
//                         a press can emit more than one code.
//  * Locks below are per button and only taken by mapped codes: an unmapped
//    code never consumes the lock of a real press.
//
// Keep actions here, not in the Shelly script (its JS sandbox has no Math.random).
// When you want to map a new code, reuse the "if lock === null" pattern and
// remember that one press can emit two consecutive codes.

var Timer bleBtn1Lock = null
var Timer bleBtn3Lock = null

rule "BLE button1"
when Channel 'mqtt:topic:shelly:ble-script:button1:click' triggered
then
	var click = receivedEvent.toString.trim
	logInfo("BLE button", "button1: click=" + click)
	if (click == "1") {
		if (bleBtn1Lock === null) {
			bleBtn1Lock = createTimer(now.plusSeconds(10), [| bleBtn1Lock = null ])
			logInfo("BLE button", "button1: single click -> tsBagnoP1 ON")
			tsBagnoP1.sendCommand(ON)
			shelly09_R1.sendCommand(ON)
		} else {
			logWarn("BLE button", "button1: duplicate event ignored (debounce)")
		}
	} else {
		logInfo("BLE button", "button1: click code " + click + " not mapped")
	}
end

rule "BLE button2"
when Channel 'mqtt:topic:shelly:ble-script:button2:click' triggered
then
	var click = receivedEvent.toString.trim
	logInfo("BLE button", "button2: click=" + click)
	logInfo("BLE button", "button2: click code " + click + " not mapped")
end

rule "BLE button3"
when Channel 'mqtt:topic:shelly:ble-script:button3:click' triggered
then
	var click = receivedEvent.toString.trim
	logInfo("BLE button", "button3: click=" + click)
	if (click == "1") {
		if (bleBtn3Lock === null) {
			bleBtn3Lock = createTimer(now.plusSeconds(10), [| bleBtn3Lock = null ])
			logInfo("BLE button", "button3: single click -> tsBagnoP1 OFF")
			tsBagnoP1.sendCommand(OFF)
			shelly09_R1.sendCommand(OFF)
		} else {
			logWarn("BLE button", "button3: duplicate event ignored (debounce)")
		}
	} else {
		logInfo("BLE button", "button3: click code " + click + " not mapped")
	}
end

rule "BLE button4"
when Channel 'mqtt:topic:shelly:ble-script:button4:click' triggered
then
	var click = receivedEvent.toString.trim
	logInfo("BLE button", "button4: click=" + click)
	logInfo("BLE button", "button4: click code " + click + " not mapped")
end
