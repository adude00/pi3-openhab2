rule "One startup rule to rule them all"
  when
    //System started
    System reached start level 100
  then

    tsSoggiornoWait.sendCommand(OFF)
    tsSoggiornoRunning.sendCommand(OFF)
    logInfo("tsSoggiornoWait","System started: Turning off tsSoggiornoWait and tsSoggiornoRunning")

    tsCamera1Wait.sendCommand(OFF)
    tsCamera1Running.sendCommand(OFF)
    logInfo("tsCamera1Wait","System started: Turning off tsCamera1Wait and tsCamera1Running")

    tsCamera2Wait.sendCommand(OFF)
    tsCamera2Running.sendCommand(OFF)
    logInfo("tsCamera2Wait","System started: Turning off tsCamera2Wait and tsCamera2Running")

end


// Fires once per boot only: "start level 100" is reached during startup and never
// again while the server runs, so this is the ONLY place we notify a startup.
rule "Startup - Prowl notification"
  when
    System reached start level 100
  then
    // Wait one minute so items, the MQTT bridge and the prowl broker are fully
    // loaded before notifying (the broker itself may still be starting up).
    createTimer(now.plusMinutes(1), [ |
        val prowl = getActions("prowl", "prowl:broker:mybroker")
        if (prowl !== null) {
            prowl.pushNotification("OPENHAB: Started", "The server has just started.")
        } else {
            logWarn("STARTUP", "Prowl broker not available - skipping startup notification")
        }
    ])
end
