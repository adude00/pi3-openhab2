var Timer lavatriceCheckTimer = null

rule "Lavatrice - washing cycle monitor"
when
    Item tuya02_Power changed //or
    //Time cron "0 * * * * ?"          // safety-net poll every minute
then
    // Only run if the master switch is ON
    if (alexa_lavatrice.state != ON) {
        return
    }

    // Guard against NULL/UNDEF power readings
    if (tuya02_Power.state == NULL || tuya02_Power.state == UNDEF) {
        return
    }

    val minPower = tuya02_Power.minimumSince(now.minusMinutes(4))
    val maxPower = tuya02_Power.maximumSince(now.minusMinutes(2))

    if (minPower === null || maxPower === null) {
        // not enough persisted history yet
        return
    }

    val minVal = (minPower.state as Number).floatValue
    val maxVal = (maxPower.state as Number).floatValue

    // Cycle started: power never dropped below 30W in the last 4 minutes
    if (alexa_lavatrice_running.state != ON && minVal > 30) {
        alexa_lavatrice_running.sendCommand(ON)
        logInfo("LAVATRICE", "Washing cycle started (min power last 4min = " + minVal + "W)")
    }
    // Cycle finished: power never rose above 2W in the last 2 minutes
    else if (alexa_lavatrice_running.state == ON && maxVal < 2) {
        alexa_lavatrice_running.sendCommand(OFF)
        logInfo("LAVATRICE", "Washing cycle finished (max power last 2min = " + maxVal + "W)")

        val prowl = getActions("prowl", "prowl:broker:mybroker")
        prowl.pushNotification("LAVATRICE: Finita", "La lavasciuga ha finito il lavaggio")

        var String message;
        message= "La lavatrice ha finito il lavaggio. Ripeto. La lavatrice ha finito il lavaggio. Vai a sistemare i vestiti!"

        Echo_Soggiorno_TTS.sendCommand(message)
        Echo_Studio_TTS.sendCommand(message)
        Echo_Giochi_TTS.sendCommand(message)
        Echo_Matrimoniale_TTS.sendCommand(message)

        logInfo("LAVATRICE", "Mandata notifica su prowl ed Alexa, spento alexa_lavatrice_running")

    }
end

rule "Lavatrice spina offline"
  when
    Item tuya02_Reachable changed from Online to Offline
  then
    alexa_lavatrice_running.sendCommand(OFF)
    tuya02_Power.postUpdate(0)
    logInfo("LAVATRICE", "Spina offline, disattivo la notifica su alexa e imposto consumo a 0W")
end

rule "Lavatrice spina spenta"
  when
    Item tuya02_Switch changed from ON to OFF
  then
    alexa_lavatrice_running.sendCommand(OFF)
    logInfo("LAVATRICE", "Spina spenta, disattivo la notifica su alexa")
end

