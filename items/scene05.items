Number Scene05Condition3bisNum 	"Temp Clima [%.1f °C]" 		<settings>  (gScene05)
Switch Scene05Condition4 	"Controllo Termostato Camera 1 [%s]" 	<settings>  (gScene05)
Switch Scene05Condition4Power 	"Stato Termostato Camera 1 ON/OFF [%s]" 	<settings>  (gScene05,gSceneHvacPower)
Switch Scene05Condition4bis 	"Modifica Temp TS [%s]" 	<settings>  (gScene05)
Number Scene05Condition4bisNum 	"Temp Termostato [%.1f °C]" 	<settings>  (gScene05)
Switch Scene05Condition5        "Camera 1 Silent [%s]"          <settings>  (gScene05)
Switch Scene05Condition6        "Spegni Clima Giochi [%s]"      <settings>  (gScene05)
Switch Scene05Condition7        "Modifica Volume Alexa"         <settings>  (gScene05)
